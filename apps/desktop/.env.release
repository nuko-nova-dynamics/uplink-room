# What packaged builds talk to (`electron-vite build --mode release`, used by `pnpm dist`).
# Both values are public: the production Convex deployment and the Clerk publishable key.
# Vite gives `.env.release` priority over `.env.local`, so local development is unaffected.
VITE_CONVEX_URL=https://fleet-jaguar-632.convex.cloud
# The Clerk production instance "Uplink Room", Frontend API https://clerk.uplinkroom.com (ADR 0014).
# The main process reads that host from this key for the CSP (src/main/index.ts, clerkHost).
VITE_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsudXBsaW5rcm9vbS5jb20k
# PostHog project "Uplink Room" (US Cloud). A project key is public: it can only send events.
# Only release builds carry it, so development, tests and screenshot runs send no usage data.
VITE_POSTHOG_KEY=phc_owDqYsAdcmheqXtaFZcRFQ5oX6byh5MdiKzfL7JsZXfX
# Sentry project uplink-room-desktop. A DSN is public: it only lets a client send events.
# See docs/error-reports.md.
VITE_SENTRY_DSN=https://8b2f4cc7dd1875614e3f26207d157bf2@o4510681284804608.ingest.us.sentry.io/4512365823787008
