{
  "name": "uplink-room",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run --config scripts/ui-lint/vitest.config.mjs && pnpm -r --no-bail --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "oxlint . && node scripts/ui-lint/index.mjs",
    "specs": "node scripts/specs.mjs",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "release:mac": "node apps/desktop/scripts/release-mac.ts",
    "release:upload": "node apps/desktop/scripts/release.ts",
    "release:empty-test": "node apps/desktop/scripts/release.ts --empty test",
    "postinstall": "node scripts/fix-node-pty.mjs",
    "lint:baseline": "node scripts/ui-lint/index.mjs --update"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "css-tree": "3.2.1",
    "oxc-parser": "0.157.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "svg-path-bbox": "2.1.0",
    "tsc-rs": "0.8.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
