{
  "name": "@uplink-room/bridge",
  "license": "MIT",
  "version": "0.2.27",
  "private": true,
  "description": "The Uplink Room bridge: shares this machine's terminals with the room.",
  "type": "module",
  "exports": {
    "./config": "./src/config.ts",
    "./platform": "./src/platform.ts",
    "./scrub": "./src/telemetry/scrub.ts",
