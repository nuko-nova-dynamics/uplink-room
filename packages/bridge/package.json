    "@types/ws": "8.18.2",
    "@uplink-room/protocol": "workspace:*",
    "@vercel/blob": "2.8.2",
    "convex": "1.49.0",
    "rolldown": "1.2.16",
    "smol-toml": "1.9.1",
    "vitest": "5.0.5",
    "ws": "8.21.0"
  }
}
