#!/usr/bin/env node
// A scripted `rex` for the bridge tests.
//
// Without FAKE_REX_DIR it plays one fixed session ('fake', block 'block-one'): `events` prints a
// working, a blocked and an exited event; anything else prints no program-status records.
//
// With FAKE_REX_DIR it keeps a small Rex in that folder, answering the calls the bridge makes the
// way Rex 0.0.1793741575 answers them (checked against `rex help` and the live CLI on 2026-11-04):
//   running              the server is up; without it every call fails as Rex does with autostart off
//   sessions.json        [{ session_id, label, windows: [{ window_id, label, blocks: [{ block_id, label, creator_name }] }] }]
//   calls.log            one JSON line per call (its arguments)
//   events/<session>     the session's events, one JSON line each, as `rex events -s SESSION --json` prints them
//   owned/<block>        a Rex app owns this tab, so `resize` from a client doesn't apply
//   records/<block>      the tab's program-status records, as `block call … program_status` returns them
// A new tab (`new`, `window new`) runs its command on a real pty in tools/rexTab.mjs, which stays up
// as the tab: it logs output to out/<block>, turns OSC 7501 reports into program-status events, and
// takes resizes (SIGUSR1) and a close (SIGTERM) like Rex.
import { appendFileSync, existsSync, mkdirSync, readFileSync, writeFileSync, openSync, statSync, readSync, closeSync } from "node:fs";
import { spawn } from "node:child_process";
import { join } from "node:path";
import { randomUUID } from "node:crypto";

// `-S SERVER` picks the server; the fake has one, and logs which server each call named.
const raw = process.argv.slice(2).filter((a) => a !== "--autostart=false");
const server = raw.indexOf("-S") >= 0 ? raw[raw.indexOf("-S") + 1] : undefined;
const args = server === undefined ? raw : raw.filter((_, i) => i !== raw.indexOf("-S") && i !== raw.indexOf("-S") + 1);
const dir = process.env.FAKE_REX_DIR;

if (!dir) {
  if (args[0] !== "events") {
    console.log('{"records":[]}');
    process.exit(0);
  }
  const event = (name, payload) => console.log(JSON.stringify({ type: "session_event", payload: { session_id: "fake", event: { type: "block_event", payload: { block_id: "block-one", creator_name: "com.superlogical.terminal", name, payload } } } }));
  event("program_status_changed", { record: { state: "working" } });
  event("program_status_changed", { record: { state: "blocked", kind: "permission", msg: "Approve build?" } });
  setTimeout(() => event("child_exited", { exit_code: 0 }), 30);
  setTimeout(() => {}, 10000);
} else {
  appendFileSync(join(dir, "calls.log"), JSON.stringify(args) + "\n");
  appendFileSync(join(dir, "servers.log"), JSON.stringify(server ?? null) + "\n");
  if (!existsSync(join(dir, "running"))) {
    process.stderr.write(`Error: no Rex server is running at ${dir}, and autostart is disabled\n`);
    process.exit(4);
  }
  const file = join(dir, "sessions.json");
  const sessions = () => (existsSync(file) ? JSON.parse(readFileSync(file, "utf8")) : []);
  const save = (list) => writeFileSync(file, JSON.stringify(list));
  const flag = (name) => {
    const words = args.slice(0, args.includes("--") ? args.indexOf("--") : args.length);
    const i = words.indexOf(name);
    return i < 0 ? undefined : words[i + 1];
  };
  const session = (target) => sessions().find((s) => s.session_id === target || s.label.toLowerCase() === String(target).toLowerCase());
  const command = args.includes("--") ? args.slice(args.indexOf("--") + 1) : [];
  const openTab = (sessionId, cwd) => {
    const block = `block:${randomUUID()}`;
    for (const sub of ["tabs", "out", "events", "resize", "owned"]) mkdirSync(join(dir, sub), { recursive: true });
    // FAKE_REX_NO_PROGRAM: the tab runs nothing, so a test can connect to the bridge as its host.
    if (process.env.FAKE_REX_NO_PROGRAM) return block;
    const tab = spawn(process.execPath, [join(import.meta.dirname, "rexTab.mjs"), dir, sessionId, block, cwd ?? process.cwd(), ...command], {
      detached: true,
      stdio: "ignore",
      env: process.env,
    });
    writeFileSync(join(dir, "tabs", block), String(tab.pid));
    tab.unref();
    return block;
  };
  const [a, b] = args;
  if (a === "ls") {
    console.log(JSON.stringify({ sessions: sessions().map(({ session_id, label }) => ({ session_id, label })) }));
  } else if (a === "window" && b === "ls") {
    const s = session(flag("-s"));
    if (!s) fail("not_found");
    console.log(JSON.stringify({ session_id: s.session_id, label: s.label, windows: s.windows.map((w) => ({ window_id: w.window_id, label: w.label, layers: [{ kind: "tiled", blocks: w.blocks }] })) }));
  } else if (a === "new") {
    const label = args[1];
    const id = `session:${randomUUID()}`;
    const windowId = `window:${randomUUID()}`;
    const block = openTab(id, flag("-c"));
    save([...sessions(), { session_id: id, label, windows: [{ window_id: windowId, label: flag("--window") ?? "Window", blocks: [{ block_id: block, label: "shell", creator_name: "com.superlogical.terminal" }] }] }]);
    console.log(JSON.stringify({ session_id: id, initial_windows: [{ window_id: windowId, block_ids: [block], revision: 1 }] }));
  } else if (a === "window" && b === "new") {
    const list = sessions();
    const s = list.find((x) => x.session_id === flag("-s") || x.label.toLowerCase() === String(flag("-s")).toLowerCase());
    if (!s) fail("session_not_found");
    // The label is the first word after `new` that isn't a flag or a flag's value.
    const words = args.slice(2, args.includes("--") ? args.indexOf("--") : args.length);
    const valued = new Set(["-s", "-c", "--shell"]);
    let label = "Window";
    for (let i = 0; i < words.length; i++) {
      if (valued.has(words[i])) i++;
      else if (!words[i].startsWith("-")) {
        label = words[i];
        break;
      }
    }
    const windowId = `window:${randomUUID()}`;
    const block = openTab(s.session_id, flag("-c"));
    s.windows.push({ window_id: windowId, label, blocks: [{ block_id: block, label: "shell", creator_name: "com.superlogical.terminal" }] });
    save(list);
    console.log(JSON.stringify({ window_id: windowId, block_ids: [block], revision: 2 }));
  } else if (a === "block" && b === "call") {
    const block = flag("-b");
    const method = args.find((w, i) => i > 1 && !w.startsWith("-") && args[i - 1] !== "-s" && args[i - 1] !== "-b");
    if (method === "resize") {
      const size = JSON.parse(args[args.indexOf("resize") + 1]);
      if (!existsSync(join(dir, "owned", block))) {
        writeFileSync(join(dir, "resize", block), JSON.stringify(size));
        try {
          process.kill(Number(readFileSync(join(dir, "tabs", block), "utf8")), "SIGUSR1");
        } catch {}
      }
      console.log("{}");
    } else if (method === "program_status") {
      const records = join(dir, "records", block);
      console.log(existsSync(records) ? readFileSync(records, "utf8") : '{"records":[]}');
    } else console.log('{"records":[]}');
  } else if ((a === "block" || a === "window") && b === "close") {
    const target = args.slice(2).find((w, i, all) => !w.startsWith("-") && all[i - 1] !== "-s");
    const blocks = sessions().flatMap((s) => s.windows.filter((w) => w.window_id === target || w.blocks.some((x) => x.block_id === target)).flatMap((w) => w.blocks.map((x) => x.block_id)));
    for (const block of blocks) {
      try {
        process.kill(Number(readFileSync(join(dir, "tabs", block), "utf8")), "SIGTERM");
      } catch {}
    }
  } else if (a === "events") {
    // Streams the session's events from now on, as `rex events -s SESSION --json` does.
    const s = flag("-s");
    const log = join(dir, "events", s);
    mkdirSync(join(dir, "events"), { recursive: true });
    if (!existsSync(log)) writeFileSync(log, "");
    // FAKE_REX_EVENTS_DELAY_MS: the stream starts late, as on a loaded machine.
    const delay = Number(process.env.FAKE_REX_EVENTS_DELAY_MS ?? 0);
    if (delay) await new Promise((resolve) => setTimeout(resolve, delay));
    let offset = statSync(log).size;
    // As Rex does, the stream's first line is its own client joining the session: from here on, every
    // event of the session comes through.
    console.log(JSON.stringify({ type: "session_event", payload: { session_id: s, event: { type: "client_connected", payload: { client_id: `client:${randomUUID()}` } } } }));
    setInterval(() => {
      // Rex quit: the stream ends, as `rex events` does when the server goes.
      if (!existsSync(join(dir, "running"))) process.exit(0);
      const size = statSync(log).size;
      if (size <= offset) return;
      const fd = openSync(log, "r");
      const buffer = Buffer.alloc(size - offset);
      readSync(fd, buffer, 0, buffer.length, offset);
      closeSync(fd);
      offset = size;
      process.stdout.write(buffer);
    }, 50);
  } else {
    fail("unknown command");
  }
}

function fail(code) {
  process.stderr.write(`Error: ${code}\n`);
  process.exit(1);
}
