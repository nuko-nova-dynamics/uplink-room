#!/usr/bin/env node
// A scripted stand-in for Cua's `cua` CLI (0.10.0), for the bridge's Space tests. It answers the
// commands the Space adapter runs from `$CUA_HOME/fake-state.json` and appends each call, with the
// token it was given in CUA_ENV_TOKEN, to `$CUA_HOME/calls.jsonl`.
import { appendFileSync, existsSync, readFileSync, writeFileSync } from "node:fs";
import { join } from "node:path";

const home = process.env.CUA_HOME;
const state = JSON.parse(readFileSync(join(home, "fake-state.json"), "utf8"));
const args = process.argv.slice(2);
appendFileSync(join(home, "calls.jsonl"), JSON.stringify({ args, token: process.env.CUA_ENV_TOKEN ?? null }) + "\n");
const out = (value) => process.stdout.write(JSON.stringify(value) + "\n");
const fail = (message) => {
  process.stderr.write(`cua: ${message}\n`);
  process.exit(1);
};

if (args[0] === "spaces" && args[1] === "ls") {
  out({ spaces: state.spaces, machines: [], durable: [] });
} else if (args[0] === "sb" && args[1] === "ls") {
  // Each local sandbox with its state: `sandboxStates[id]`, else what `spaces ls` says, else running.
  out(
    state.spaces
      .filter((s) => s.id.startsWith("local:"))
      .map((s) => ({ id: s.id, name: s.name, location: "local", state: state.sandboxStates?.[s.id] ?? (s.power_state || "running") })),
  );
} else if (args[0] === "sb" && args[1] === "info") {
  const url = state.endpoints[args[2]];
  if (!url) fail(`no sandbox ${args[2]}`);
  // A slow lookup, answering with the address it read before the wait, for reconnect races.
  if (state.sbInfoGate) {
    writeFileSync(`${state.sbInfoGate}.entered`, "");
    while (!existsSync(state.sbInfoGate)) await new Promise((r) => setTimeout(r, 10));
  }
  if (state.slowSbInfoMs) await new Promise((r) => setTimeout(r, state.slowSbInfoMs));
  out({ id: args[2], endpoints: { env: url }, state: "running" });
} else if (args[0] === "spacesd" && args[1] === "call") {
  const [, , url, method, body = "{}"] = args;
  if (process.env.CUA_ENV_TOKEN !== state.token) fail("permission denied: bad token (Unauthenticated)");
  if (!Object.values(state.endpoints).includes(url)) fail(`cannot reach ${url}`);
  const request = JSON.parse(body);
  if (method === "SystemService/CreateViewerTicket") {
    // A slow Cua, for checking that taking access away never waits on it.
    if (state.slowPrincipal && request.principal.id === state.slowPrincipal) await new Promise((r) => setTimeout(r, state.slowMs ?? 3000));
    // The first ticket for a person and policy is `ticket-<policy>-<id>`; later ones get `-2`, `-3`...
    const base = `ticket-${request.policy}-${request.principal.id}`;
    const counter = join(home, `count-${base}`);
    const n = existsSync(counter) ? Number(readFileSync(counter, "utf8")) + 1 : 1;
    writeFileSync(counter, String(n));
    const ticket = n === 1 ? base : `${base}-${n}`;
    const ttl = parseInt(request.ttl, 10) || 3600;
    out({ ticket, expiresAt: new Date(Date.now() + ttl * 1000).toISOString(), viewerPath: `/viewer/#ticket=${ticket}` });
  } else if (method === "ComputerService/Screenshot") {
    out({ image: Buffer.from("fake-jpeg").toString("base64"), format: "IMAGE_FORMAT_JPEG", imageSize: { width: 1280, height: 800 }, screenshotId: "shot-1" });
  } else if (method === "ComputerService/Pointer" || method === "ComputerService/Keyboard") {
    out({ report: { delivery: "DELIVERY_FOREGROUND" } });
  } else {
    fail(`unknown method ${method}`);
  }
} else {
  fail(`unknown command ${args.join(" ")}`);
}
